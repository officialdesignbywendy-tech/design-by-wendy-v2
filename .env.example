# Copy these into Vercel: Project Settings > Environment Variables.
# Never commit a real .env file.

# REQUIRED for the contact form to deliver email. Secret: create it at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where enquiries are delivered. Defaults to officialdesignbywendy@gmail.com
CONTACT_TO_EMAIL=officialdesignbywendy@gmail.com

# Optional. Sender shown on the email. Defaults to "Design by Wendy <onboarding@resend.dev>",
# which Resend only lets you send to the email address of your own Resend account.
# To send to any address, verify your domain in Resend and use e.g. "Design by Wendy <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
